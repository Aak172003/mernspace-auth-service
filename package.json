{
   "name": "mern_auth_service",
   "version": "1.0.0",
   "description": "The user management service",
   "main": "index.js",
   "scripts": {
      "dev": "cross-env NODE_ENV=dev nodemon src/server.ts --legacy-watch",
      "format:check": "prettier . --check",
      "format:fix": "prettier . --write",
      "lint:check": "eslint .",
      "lint:fix": "eslint . --fix",
      "test": "jest --watch --runInBand",
      "prepare": "husky",
      "start": "ts-node src/index.ts",
      "typeorm": "typeorm-ts-node-commonjs",
      "migration:generate": "npm run typeorm -- migration:generate src/migration/migration -d src/config/data-source.ts",
      "migration:run": "npm run typeorm -- migration:run -d src/config/data-source.ts"
   },
   "author": "Aakash Prajapati <prajapatiaakash364@gmail.com>",
   "license": "ISC",
   "devDependencies": {
      "@eslint/js": "^9.28.0",
      "@types/bcrypt": "^5.0.2",
      "@types/cookie-parser": "^1.4.9",
      "@types/express": "^5.0.2",
      "@types/http-errors": "^2.0.4",
      "@types/jest": "^29.5.14",
      "@types/jsonwebtoken": "^9.0.9",
      "@types/node": "^22.15.29",
      "@types/supertest": "^6.0.3",
      "@types/winston": "^2.4.4",
      "cross-env": "^7.0.3",
      "dotenv": "^16.5.0",
      "eslint": "^9.28.0",
      "husky": "^9.1.7",
      "jest": "^29.7.0",
      "lint-staged": "^16.1.0",
      "mock-jwks": "^1.0.10",
      "nodemon": "^3.1.10",
      "nock": "^13.5.6",
      "prettier": "3.5.3",
      "supertest": "^7.1.1",
      "ts-jest": "^29.3.4",
      "ts-node": "^10.9.2",
      "typescript": "^5.8.3",
      "typescript-eslint": "^8.33.1"
   },
   "lint-staged": {
      "*.ts": [
         "npm run format:fix",
         "npm run lint:fix"
      ]
   },
   "dependencies": {
      "bcrypt": "^6.0.0",
      "cookie-parser": "^1.4.7",
      "express": "^5.1.0",
      "express-jwt": "^8.5.1",
      "express-validator": "^7.2.1",
      "http-errors": "^2.0.0",
      "jsonwebtoken": "^9.0.2",
      "jwks-rsa": "^3.2.0",
      "pg": "^8.14.1",
      "reflect-metadata": "^0.2.2",
      "rsa-pem-to-jwk": "^1.1.3",
      "typeorm": "0.3.24",
      "winston": "^3.17.0"
   }
}